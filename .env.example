# Optional: copy to .env to override compose.yaml's local defaults.
# These variables configure Compose; application config is not wired yet.
# For another clone running alongside this one, change the project AND ports.
COMPOSE_PROJECT_NAME=n2f-rs
N2F_POSTGRES_PORT=7320
N2F_POSTGRES_DB=n2f
N2F_POSTGRES_USER=n2f
N2F_POSTGRES_PASSWORD=n2f_local
N2F_REDIS_PORT=7321

# Local mail capture
N2F_SMTP_PORT=7325
N2F_MAILPIT_UI_PORT=7326

# Local S3 service; credentials initialize SeaweedFS's local identity.
N2F_S3_PORT=7330
N2F_S3_ACCESS_KEY=n2f_access
N2F_S3_SECRET_KEY=n2f_secret_local
N2F_S3_BUCKET=n2f-local

# Telemetry backend; application exporters are not wired yet.
N2F_GRAFANA_PORT=7340
N2F_GRAFANA_USER=n2f
N2F_GRAFANA_PASSWORD=n2f_local
N2F_OTLP_GRPC_PORT=7341
N2F_OTLP_HTTP_PORT=7342
